  "source_defects": [
    {
      "defect_id": "L05-D001",
      "evidence": "The generic dXXX explanation calls density, mass, and likelihood the same returned quantity.",
      "kind": "density-mass-likelihood-conflation",
      "note": "A d* function returns a density or mass value; it is a likelihood factor only when data are fixed and the parameter varies."
    },
    {
      "defect_id": "L05-D002",
      "evidence": "x=rnorm(n=1,mean=3,sd=2)\n\nx",
      "kind": "normal-simulation-size-contradiction",
      "note": "x receives one draw, but the following prose/formulas/outputs repeatedly claim that x contains ten draws."
    },
    {
      "defect_id": "L05-D003",
      "evidence": [
        "rnorm(n=1,mean=3,sd=2)",
        "rnorm(n=10,mean=3,sd=2)",
        "x=rnorm(n=1,mean=3,sd=2)\n\nx",
        "z=rexp(n=30,rate=2)\nz",
        "z=rexp(n=1000,rate=2)"
      ],
      "kind": "unseeded-reported-simulations",
      "note": "Exact downstream random outputs are reported without a preceding seed or a frozen generated vector."
    },
    {
      "defect_id": "L05-D004",
      "evidence": [
        "\\(L(X_1,\\ldots,X_{10}) = \\prod_i f_X(X_i)\\)",
        "\\(l(X_1,\\ldots,X_10)=\\sum_i log(f_X(X_i))\\)"
      ],
      "kind": "likelihood-as-random-data-function",
      "note": "These are joint-density expressions; likelihood/log-likelihood must be functions of parameters for fixed observations."
    },
    {
      "defect_id": "L05-D005",
      "evidence": "lik.vals=rep(NA,length(theta.vals))",
      "kind": "missing-grid-search-computation",
      "note": "The visible code never assigns computed likelihoods into lik.vals before plotting and which.max."
    },
    {
      "defect_id": "L05-D006",
      "evidence": [
        "theta.vals=seq(1,100,by=0.1)\ntheta.vals",
        "\\(\\hat{\\theta}_{grid}=8.9\\)"
      ],
      "kind": "grid-approximation-called-exact-mle",
      "note": "8.9 is the maximizer on a 0.1-spaced grid; the exact exponential-mean MLE for the listed data is 133/15."
    },
    {
      "defect_id": "L05-D007",
      "evidence": [
        "\\(h(\\theta)=\\frac{d}{d\\theta} \\ell(\\theta)=0\\)",
        "\\(h(\\theta^{(0)}=\\frac{d}{d\\theta}\\ell(\\theta^{(0)})\\)"
      ],
      "kind": "score-definition-and-delimiter",
      "note": "Define h(theta)=ell'(theta), then solve h(theta)=0; the evaluation h(theta^(0)) also lacks a closing parenthesis."
    },
    {
      "defect_id": "L05-D008",
      "evidence": "The narrative evaluates/takes the tangent of the log-likelihood after deriving Newton root-finding for its score.",
      "kind": "newton-tangent-of-wrong-function",
      "note": "The tangent and x-intercept update apply to h=ell', and a score root still requires maximum/domain checks."
    },
    {
      "defect_id": "L05-D009",
      "evidence": [
        "\\(t=1, 2, \\ldots\\)",
        "\\[\\begin{aligned}\n             \\theta^{(t+1)}=\\theta^{(t)}-\\frac{h(\\theta^{(t)})}{h^\\prime(\\theta^{(t)})}=\\theta^{(t)}-\\frac{\\frac{d}{d\\theta}\\ell(\\theta^{(t)})}{\\frac{d^2}{d\\theta^2}\\ell(\\theta^{(t)})}\\end{aligned}\\]"
      ],
      "kind": "newton-index-start",
      "note": "Given theta^(0), the displayed recurrence's first update occurs at t=0, not t=1."
    },
    {
      "defect_id": "L05-D010",
      "evidence": "\\[\n\\ell(\\theta)=\\log(L(\\theta))=\\log\\left(\\prod_{i=1}^n f_X(x_i,\\theta)\\right)=\\sum_{i=1}^n \\log f_X(x_i)=\\sum_{i=1}^n\\left(-\\log(\\theta) -\\frac{ x_i}{\\theta}\\right)\n\\]",
      "kind": "loglikelihood-parameter-notation",
      "note": "The same equality first writes f_X(x_i,theta) and then drops theta from every log-density term."
    },
    {
      "defect_id": "L05-D011",
      "evidence": [
        "out=optim(2,nll.exp,x=x)",
        "out2=optim(0.5,nll.exp,x=x)\nout2",
        "out=optim(c(-1,1),nll.norm,y=y)\nout"
      ],
      "kind": "optim-method-ambiguity",
      "note": "The hand recurrence is Newton-Raphson, whereas optim() without method defaults to Nelder-Mead; the source does not distinguish them."
    },
    {
      "defect_id": "L05-D012",
      "evidence": "nll.exp=function(theta,x){\n  -sum(dexp(x,rate=1/theta,log=TRUE))\n}",
      "kind": "exponential-rate-scale-reversal",
      "note": "The prose calls theta a rate, but rate=1/theta makes theta the mean/scale."
    },
    {
      "defect_id": "L05-D013",
      "evidence": "out=optim(2,nll.exp,x=x)",
      "kind": "unconstrained-positive-exponential-parameter",
      "note": "A positive start does not keep optim from evaluating a nonpositive exponential mean/scale."
    },
    {
      "defect_id": "L05-D014",
      "evidence": "The source explicitly tells readers to ignore most optim warnings, including invalid negative trial parameters.",
      "kind": "unsafe-warning-advice",
      "note": "Domain violations and nonfinite objectives must be prevented/diagnosed, not dismissed."
    },
    {
      "defect_id": "L05-D015",
      "evidence": "nll.exp(0.112793,x)",
      "kind": "objective-check-uses-reciprocal-parameter",
      "note": "Under the implemented mean parameterization, the reported objective 47.73448 is evaluated near theta=8.865625, not theta=0.112793."
    },
    {
      "defect_id": "L05-D016",
      "evidence": [
        "$par\n[1] 8.865625\n\n$value\n[1] 47.73448\n\n$counts\nfunction gradient \n      30       NA \n\n$convergence\n[1] 0\n\n$message\nNULL",
        "32 iterations"
      ],
      "kind": "optim-counts-misinterpreted",
      "note": "optim $counts records objective/gradient evaluations (30 and NA here), not 32 algorithmic iterations."
    },
    {
      "defect_id": "L05-D017",
      "evidence": "convergence=0 is treated as proof that the numerical MLE is trustworthy.",
      "kind": "convergence-code-overclaim",
      "note": "Code 0 only reports the optimizer's stopping condition; domain, objective, sensitivity, and derivative/benchmark checks remain necessary."
    },
    {
      "defect_id": "L05-D018",
      "evidence": "8.6875 vs 8.65625",
