  "source_defects": [
    {
      "classification": "qualification-omission",
      "defect_id": "L09-D001",
      "evidence": "Typical \\(\\beta\\) values are 0.05, 0.10, and 0.20.",
      "kind": "type-two-error-and-power-parameter-dependence-omitted",
      "note": "For a composite alternative, beta and power are functions of the true parameter value. They are not single free-standing design constants."
    },
    {
      "classification": "outright-overgeneralization",
      "defect_id": "L09-D002",
      "evidence": "However, we cannot decrease both. As \\(\\alpha\\) decreases, \\(\\beta\\) increases.",
      "kind": "alpha-beta-tradeoff-missing-fixed-design-qualification",
      "note": "The monotone tradeoff is for a fixed sample size, test family, and specified alternative. Increasing information can reduce both errors."
    },
    {
      "classification": "boundary-omission",
      "defect_id": "L09-D003",
      "evidence": [
        "\\(|T^*|>c\\)",
        "\\(|T^*|<c\\)"
      ],
      "kind": "critical-boundary-decision-unspecified",
      "note": "The two rules omit |T*|=c. Equality is null-probability-zero only for an appropriate continuous statistic. A discrete exact-level test needs an explicit boundary decision and, when no nonrandomized cutoff has the desired size, randomization on the equality set."
    },
    {
      "classification": "boundary-omission",
      "defect_id": "L09-D004",
      "evidence": {
        "decision_rule": "\\(P\\le \\alpha\\)",
        "definition": "probability that we’d observe a more extreme statistic than we did",
        "summary_rule": "p-value is smaller than the significance level"
      },
      "kind": "p-value-definition-excludes-observed-equality",
      "note": "Define the p-value using outcomes at least as extreme as the observation under the null distribution. The source also alternates <= and strict smaller-than decision wording; the derivative must state one complete boundary convention."
    },
    {
      "classification": "outright-mathematical-defect",
      "defect_id": "L09-D005",
      "evidence": {
        "discrete_equivalent": "Y>=273, equivalently p-hat>=0.273",
        "source_formula": "\\[Z>1.645 \\text{ or equivalently } \\hat{p}>0.273\\]",
        "unrounded_cutoff": "0.27252509017739995"
      },
      "kind": "rounded-proportion-cutoff-not-equivalent",
      "note": "Z>1.645 is equivalent to p-hat>0.27252509017739995. Because p-hat=Y/1000, the discrete rule is Y>=273 or p-hat>=0.273, not p-hat>0.273."
    },
    {
      "classification": "approximation-qualification-omission",
      "defect_id": "L09-D006",
      "evidence": {
        "exact_beta_at_p_eq_0.27_for_Y_ge_273": "0.572735965453398",
        "exact_size_for_Y_ge_273": "0.051194671302778",
        "exact_size_for_Y_ge_274": "0.044096329716543",
        "randomize_at_Y_eq_273_probability": "0.831697124143108",
        "source_type_two_formula": "\\[\\begin{align*}\nP(\\text{Type II Error})=P(\\hat{p}<0.273\\quad if \\quad            p=0.27)=P\\left(Z<\\dfrac{0.273-0.27}{\\sqrt{\\dfrac{0.27(0.73)}{1000}}}\\right)=P(Z<0.214)=0.5847\n\\end{align*}\\]"
      },
      "kind": "normal-approximation-presented-as-exact-size-and-type-two-probability",
      "note": "The source's 0.05 and 0.5847 are Normal-approximation results. Under Binomial(1000,0.25), Y>=273 has size 0.051194671302778. An exact size-0.05 rule rejects for Y>=274 and rejects with probability 0.831697124143108 when Y=273. Label approximations or state this equality-set randomization explicitly."
    },
    {
      "classification": "inferential-overstatement",
      "defect_id": "L09-D007",
      "evidence": "reject the null hypothesis and conclude that the alternative hypothesis is true",
      "kind": "rejection-described-as-proof-alternative-is-true",
      "note": "A rejection is evidence against H0 at a controlled error rate; it does not establish certainty that Ha is true, as the lesson's own Type I error discussion demonstrates."
    },
    {
      "classification": "outright-surface-defect",
      "defect_id": "L09-D008",
      "evidence": "we should reject the null hypothesis or we should reject the null hypothesis",
      "kind": "two-tailed-rejection-conditions-omitted-from-prose",
      "note": "The two alternatives are missing their conditions. Preserve the subsequent complete rule |Z|>=1.96 and make both tails explicit in text."
    },
    {
      "classification": "outright-mathematical-overclaim",
      "defect_id": "L09-D009",
      "evidence": "the same size \\(n=25\\) is large enough for the Central Limit Theorem to apply",
      "kind": "sample-size-25-claimed-universally-sufficient-for-clt",
      "note": "No universal finite n guarantees an adequate Normal approximation for arbitrary population distributions. The exact Z result needs an iid Normal sample; otherwise approximation quality needs distributional conditions or diagnostics."
    },
    {
      "classification": "outright-numerical-defect",
      "defect_id": "L09-D010",
      "evidence": {
        "preceding_value": "\\(P(Z<-1.75)=0.0401\\)",
        "source_formula": "\\(=0.401<\\alpha=0.05\\)"
      },
      "kind": "one-mean-p-value-decimal-point-error",
      "note": "The p-value is 0.0401, not 0.401. Moreover 0.401<0.05 is false; 0.0401<0.05 supports the stated rejection."
    },
    {
      "classification": "outright-notation-defect",
      "defect_id": "L09-D011",
      "evidence": [
        "\\(t\\ge t_{0.025, 99}=1.9842\\)",
        "\\(t\\le t_{0.025, 99}=-1.9842\\)"
      ],
      "kind": "same-t-quantile-symbol-assigned-opposite-signs",
      "note": "Under the source's upper-tail convention, use t>=t_(0.025,99) and t<=-t_(0.025,99). Alternatively define lower-tail quantiles explicitly; one symbol cannot equal both signs."
    },
    {
      "classification": "proof-omission",
      "defect_id": "L09-D012",
      "evidence": {
        "displayed_bound": "\\[\\begin{align*}\n  2P(T_{99}>4.762)<2P(T_{99}>1.9842)=2(0.025)=0.05\n\\end{align*}\\]",
        "independent_two_sided_p_value": "0.000006560183365621494",
        "unsupported_next_claim": "\\(\\le 0.01<\\alpha=0.05\\)"
      },
